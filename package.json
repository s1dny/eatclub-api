{
  "name": "skills",
  "version": "0.1.0",
  "description": "Reusable agent skills with data CLIs and app starters",
  "type": "module",
  "private": true,
  "scripts": {
    "eatclub": "bun src/eatclub/cli.ts",
    "test": "bun test --timeout 120000",
    "typecheck": "tsc --noEmit",
    "lint": "bun lint",
    "fix": "bun lint --fix && bun fmt",
    "skills:install": "bun scripts/install.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "travel": "bun src/travel/cli.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "google-travel-website-api": "0.5.2",
    "osm-pbf-parser-node": "^1.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4-canary.1"
}
