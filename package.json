{
  "name": "eatclub-api",
  "version": "0.1.0",
  "description": "EatClub NSW venues, deals, live availability and menus in a libSQL database for agents to query",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "bun src/sync.ts",
    "live": "bun src/live.ts",
    "walk": "bun src/walk.ts",
    "sql": "bun src/sql.ts",
    "test": "bun test --timeout 120000",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "map": "bun src/map.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "osm-pbf-parser-node": "^1.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
